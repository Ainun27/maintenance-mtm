# ==========================================
# BACKEND API SERVER
# ==========================================
API_PORT=4000

# ==========================================
# MQTT BROKER CONFIGURATION
# ==========================================
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=sensors/+/telemetry
MQTT_CLIENT_ID=mqtt_ts_subscriber
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# ==========================================
# 1. POSTGRESQL - TIMESCALE (TIME-SERIES TELEMETRY)
# ==========================================
ENABLE_TIMESCALE=true
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=timescale_db
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=postgres_secret

# ==========================================
# 2. POSTGRESQL - MONITORING (DEVICE STATUS & ALERTS)
# ==========================================
ENABLE_MONITORING=true
MONITORING_HOST=localhost
MONITORING_PORT=5432
MONITORING_DB=monitoring_db
MONITORING_USER=postgres
MONITORING_PASSWORD=postgres_secret
