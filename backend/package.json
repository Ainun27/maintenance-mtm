  "description": "Backend MQTT subscriber & API server for PostgreSQL (Timescale & Monitoring)",
  "main": "dist/subscriber.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:dev": "tsx watch src/index.ts",
